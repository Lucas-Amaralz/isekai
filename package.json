{
  "name": "isekai",
  "version": "1.3.0",
  "description": "Salas para assistir filme e série juntos, com o som de um programa só.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-audio": "powershell -NoProfile -File helper/build.ps1",
    "dist": "npm run build-audio && electron-builder --win nsis"
  },
  "author": "Lucas Amaral",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Isekai",
  "build": {
    "appId": "com.lucasamaral.isekai",
    "productName": "Isekai",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "turn.json"
    ],
    "extraResources": [
      {
        "from": "resources/IsekaiAudio.exe",
        "to": "IsekaiAudio.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/art/icone.png"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Isekai-Setup.exe",
      "shortcutName": "Isekai",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lucas-Amaralz",
        "repo": "isekai",
        "releaseType": "release"
      }
    ]
  }
}
